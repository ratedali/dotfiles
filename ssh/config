AddKeysToAgent yes

Host github.com
    IdentityFile ~/.ssh/id_ghcli

Host ssh.dev.azure.com
    IdentityFile ~/.ssh/id_devops

Host 192.168..
    HostKeyAlgorithms +ssh-rsa

Host ebu-*
    User ebu

Host *.compute-1.amazonaws.com
    User ubuntu
    IdentityFile ~/.ssh/mukhtar_aws.pem
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null

Host *.hpc.uni-saarland.de
    User alsa00006
    IdentityFile ~/.ssh/id_uds_ed25519

Host tmux.hpc.uni-saarland.de
    HostName conduit.hpc.uni-saarland.de
    User alsa00006
    IdentityFile ~/.ssh/id_uds_ed25519
    RequestTTY yes
    RemoteCommand tmux new -A -s remote
